# Cloudflare
CF_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_account_id
CF_ZONE_ID=your_zone_id_for_calendar_mx

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft OAuth (optional — for Outlook sync)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# App
APP_URL=https://calendar.mx
APP_DOMAIN=calendar.mx
JWT_SECRET=generate_a_random_64_char_string

# Stripe (Pro tier)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Emailit)
EMAILIT_API_KEY=
EMAIL_FROM=noreply@calendar.mx

# Turnstile (bot protection)
TURNSTILE_SECRET_KEY=

# Cron
CRON_SECRET=generate_a_random_string

# Tenant provisioning (for scripts/provision-tenant.ts)
D1_DATABASE_ID=your_d1_database_id
TENANT_KV_ID=your_tenant_kv_namespace_id
